# env.sample — template for .env
# Copy to .env (or run: bash scripts/init.sh) and adjust as needed.
# All variables are optional; code defaults point at the devcontainer bind-mount paths.
# Prefix: RLM_

# ---------------------------------------------------------------------------
# Target Rust project
# ---------------------------------------------------------------------------

# Absolute path to the target Rust project: the workspace rust-analyzer opens
# and whose Markdown files are indexed for doc search. Repo-agnostic — point it
# at any Rust project (default = the bundled ripgrep sample in the devcontainer).
RLM_PROJECT_ROOT=/workspaces/ripgrep
# Deprecated alias (still honored, warns): RLM_RIPGREP_SRC=/workspaces/ripgrep

# Explicit project identity for the doc index; empty means derive it from the
# project path, git remote and root Cargo.toml. Set it when projects share /data.
RLM_PROJECT_ID=

# ---------------------------------------------------------------------------
# Rust / cargo caches
# ---------------------------------------------------------------------------

# Path to the rust-analyzer binary inside the container.
# Confirm with: rustup which rust-analyzer
RLM_RUST_ANALYZER_BIN=/usr/local/cargo/bin/rust-analyzer

# ---------------------------------------------------------------------------
# ChromaDB / doc RAG
# ---------------------------------------------------------------------------

# ChromaDB PersistentClient storage path (bind mount).
RLM_CHROMA_PATH=/workspaces/chroma

# ChromaDB collection name for the doc-RAG store.
RLM_DOC_COLLECTION=project_docs

# Glob patterns for markdown files to index (comma-separated).
# Default indexes all *.md in the target project.
RLM_DOC_GLOB_PATTERNS=**/*.md

# Comma-separated globs (relative to RLM_PROJECT_ROOT) to exclude from the doc index.
RLM_DOC_EXCLUDE_PATTERNS=**/CHANGELOG.md

# ---------------------------------------------------------------------------
# Transport (CLI-frontend daemon)
# ---------------------------------------------------------------------------

# "stdio" (default, one process per MCP client) or "streamable-http" (warm
# daemon mode for the CLI frontend). Host is always hard-coded to 127.0.0.1 in
# streamable-http mode — not configurable, and never published as a port.
RLM_TRANSPORT=stdio

# TCP port for streamable-http mode. Ignored in stdio mode.
RLM_HTTP_PORT=8000

# Idle timeout for streamable-http mode, in seconds: the daemon exits with code 0
# after this long with no request. 0 disables it. Ignored in stdio mode. A value
# passed through rlm-connect reaches the daemon only when it creates the container.
RLM_IDLE_TIMEOUT_SECONDS=3600

# Stall threshold, in seconds: when a rust-analyzer re-index shows no progress for
# this long while rust-analyzer reports itself busy, status reports analyzer_stall
# and every analyzer tool returns error with recovery "refresh". A value too low
# flags a healthy but slow re-index. 0 disables this timer; a cache-priming panic
# still marks a stall.
RLM_STALL_THRESHOLD_SECONDS=180

# Request timeout, in seconds: the server cancels a rust-analyzer request that
# has not answered after this long and returns an error envelope. Keep it under
# the CLI's 300 s read timeout. 0 disables it.
RLM_REQUEST_TIMEOUT_SECONDS=120
